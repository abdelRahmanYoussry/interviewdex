{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdelRahmanYoussry/interviewdex/blob/main/assets/tracks/schemas/track.schema.json",
  "title": "InterviewDex track metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "sourceHosts",
    "topics"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.png$"
    },
    "sourceHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "file"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/localizedText" },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.json$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "required": ["en"],
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
